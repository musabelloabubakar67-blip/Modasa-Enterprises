# Copy to .env.local. For local development, get these values from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose this to the browser or commit it.
SUPABASE_SECRET_KEY=

# Online shop payments (Paystack). Leave empty on a development machine to use the stand-in payment page.
PAYSTACK_SECRET_KEY=
# The site's public address once hosted, e.g. https://shop.example.com (used for payment return links).
NEXT_PUBLIC_SITE_URL=
